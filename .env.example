# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Port 5433 matches docker-compose.yml, which maps the container's 5432 to the
# host's 5433 so it never collides with a natively installed PostgreSQL.
# Using your own PostgreSQL instead? Change this to its port (usually 5432).
DATABASE_URL="postgresql://app_user:app_password@localhost:5433/app_dev?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payments
# Set PAYMENT_PROVIDER=mock to use the built-in mock provider (default, no
# external account needed). Set to "stripe" and supply keys below to enable
# real Stripe-backed checkout, subscriptions, and webhooks.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Notifications
# EMAIL_PROVIDER/SMS_PROVIDER/PUSH_PROVIDER = "mock" logs to the internal
# NotificationDelivery table instead of calling a real provider.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="notifications@example.com"

SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

PUSH_PROVIDER="mock"
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# File storage
# STORAGE_PROVIDER=local writes to /public/uploads. Set to "s3" and supply
# credentials to use S3-compatible object storage instead.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
