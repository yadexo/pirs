# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Port 5433 matches docker-compose.yml, which maps the container's 5432 to the
# host's 5433 so it never collides with a natively installed PostgreSQL.
# Using your own PostgreSQL instead? Change this to its port (usually 5432).
DATABASE_URL="postgresql://app_user:app_password@localhost:5433/app_dev?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Leave AUTH_URL / NEXTAUTH_URL unset: sign-in then returns to whatever address
# the site was opened on (localhost, a phone on the LAN, or the real domain).
# Setting it to localhost sends phones to their own "localhost" after sign-in.

# ---------------------------------------------------------------------------
# Payments
# Set PAYMENT_PROVIDER=mock to use the built-in mock provider (default, no
# external account needed). Set to "stripe" and supply keys below to enable
# real Stripe-backed checkout, subscriptions, and webhooks.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secrets (whsec_...). Both endpoints are the same URL,
# https://<your-domain>/api/webhooks/stripe, registered twice in Stripe because
# Stripe will not send both kinds of event to one endpoint:
#
#   STRIPE_CONNECT_WEBHOOK_SECRET  the endpoint listening to events on CONNECTED
#                                  ACCOUNTS (the clinics). This is the one that
#                                  carries clients' payments and refunds, so an
#                                  instance that takes money needs it.
#   STRIPE_WEBHOOK_SECRET          the endpoint listening to events on the
#                                  PLATFORM account itself — this agency's own
#                                  billing of its clinics.
#
# The route tries both and refuses the request only if neither signature
# verifies, so either may be left empty. A secret is issued per endpoint, so
# these are never the same locally and in production.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Apple Pay shows only on domains registered with Stripe, and with direct charges
# each domain is registered on every clinic's own connected account. The client
# app domain (CLIENT_APP_URL) and this deployment (APP_URL) are registered
# automatically; list any others here, comma-separated.
APPLE_PAY_DOMAINS=""

# Web Push for the clients' installed apps. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is sent to browsers; the private key signs and never leaves
# the server. Without all three, the app simply offers no notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# The platform's cut of each client payment, as a percentage of the subtotal
# before tax (e.g. "2.5" = 2.5%). Unset or 0 means the clinic keeps everything.
# Taken as a Stripe application fee on the clinic's own connected account.
PLATFORM_FEE_PERCENT=""

# ---------------------------------------------------------------------------
# Notifications
# EMAIL_PROVIDER/SMS_PROVIDER/PUSH_PROVIDER = "mock" logs to the internal
# NotificationDelivery table instead of calling a real provider.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="notifications@example.com"

# SMS is a documented integration point, not a working one yet: setting
# SMS_PROVIDER and the TWILIO_* vars below does not make SMS delivery work —
# lib/providers/notifications/sms.ts#TwilioSmsProvider always throws until
# someone wires it to a real account.
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Same story as SMS above: PUSH_PROVIDER=webpush and the WEB_PUSH_* vars
# below are a documented integration point that always throws
# (lib/providers/notifications/push.ts), not the push system this app
# actually uses for clients' installed apps — that's VAPID_PUBLIC_KEY/
# VAPID_PRIVATE_KEY/VAPID_SUBJECT above, and PUSH_PROVIDER/WEB_PUSH_* have
# no effect on it either way.
PUSH_PROVIDER="mock"
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# File storage
# STORAGE_PROVIDER=local writes to /public/uploads — fine for development, but
# lost on most hosts. Use "s3" in production: AWS S3, Cloudflare R2 or MinIO.
#   R2:  S3_REGION="auto"  S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
#   AWS: S3_REGION="eu-central-1"  S3_ENDPOINT=""  (leave empty)
# S3_PUBLIC_URL is the public base URL objects are served from.
# Local S3 (LocalStack): docker compose --profile s3 up -d s3
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# The host's scheduler calls /api/cron/<job> with "Authorization: Bearer
# <CRON_SECRET>" (Vercel Cron sends this automatically). Unset = cron disabled.
#   cleanup     — hourly
#   marketing   — every few minutes (scheduled campaigns, birthdays)
#   memberships — hourly; stops memberships whose grace period has run out
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Development only: makes the mock payment provider decline every payment, to
# exercise the failed-payment path. Ignored when NODE_ENV=production, and it is
# never something a client can ask for — see lib/providers/payments/mock.ts.
# ---------------------------------------------------------------------------
MOCK_PAYMENTS_DECLINE=""

# ---------------------------------------------------------------------------
# Error reporting. Unhandled server errors are always written to the log as
# one JSON line. Set SENTRY_DSN and/or ERROR_WEBHOOK_URL to also send each
# report to Sentry and/or POST it to an alerting service. Reports never
# include headers, cookies, bodies, query strings or user identity — see
# lib/observability.ts and docs/operations/sentry-setup.md.
# ---------------------------------------------------------------------------
SENTRY_DSN=""
ERROR_WEBHOOK_URL=""
APP_ENV=""

# ---------------------------------------------------------------------------
# Domains
# Three hosts, all derived from the root domain: the client app on
# login.<root>, the clinic portal on app.<root>, the platform admin on
# admin.<root>. The apex and www are NOT app hosts — they serve a separate
# marketing site, and nothing here routes or redirects on them.
#
# Only the NEXT_PUBLIC_ ones reach the browser, and they have to: the QR
# scanner reads the client-host list to decide whether a scanned link is one
# of ours, and a server-only value would read as undefined there and fall back
# to the default with no error.
#
# The *_HOST overrides exist for a host that doesn't follow the <name>.<root>
# shape; leave them unset otherwise. Keep them distinct from the client host:
# a host that serves both shadows the portal login and widens the installed
# app's scope to swallow /m/.
#
# NEXT_PUBLIC_EXTRA_CLIENT_HOSTS adds further hosts that serve a clinic at
# /<slug> (comma-separated) — a clinic's own domain, once it is verified. Not
# staging, which serves the long /app/<clinic> form.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ROOT_DOMAIN="deza.ai"
NEXT_PUBLIC_CLIENT_HOST=""
CLINIC_HOST=""
ADMIN_HOST=""
NEXT_PUBLIC_EXTRA_CLIENT_HOSTS=""

# The domain the platform moved away from. Set it and each of its listed
# addresses is answered with a permanent redirect to the host that replaced it
# (see lib/legacy-domain.ts for the table) — except /api/webhooks/stripe and
# /api/cron/*, which keep answering there so Stripe and the scheduler don't
# have to be repointed in the same breath. An old subdomain that isn't in the
# table is left alone rather than sent to a guessed host. Empty disables the
# redirect entirely.
#
# Changing this takes effect on the next deployment, not on save: Vercel binds
# environment variables to a deployment. Set it, then redeploy.
LEGACY_ROOT_DOMAIN=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Must be https:// in production: auth.config.ts derives the client app's
# __Secure-/__Host- cookie prefixes from it, and an http:// or missing value
# silently drops them while sign-in still appears to work.
APP_URL="http://localhost:3000"

# Where clients reach the app: the client host, which serves a clinic at
# /<clinic-slug> (https://login.deza.ai/riverside-wellness). Used for the QR
# code and join link a clinic shares, and for a client's own password-reset
# link. Unset, links fall back to this deployment under /app — which is what
# staging wants, since a short link there would not resolve.
CLIENT_APP_URL=""

# ---------------------------------------------------------------------------
# Self-registration
# ---------------------------------------------------------------------------
# The shared code that has to be typed on the clinic register page and the
# admin register page before an account can be created. One secret for
# everyone, deliberately temporary — see docs/operations/registration-code.md
# for how to remove or replace it.
#
# Unset (or whitespace) means registration is OFF: both pages 404, both
# actions refuse, and the login pages show no register link. That is the
# fail-closed direction, so forgetting to set it cannot leave a public
# sign-up open. Invitations — an admin inviting an admin, an owner inviting
# staff — never use the code and work regardless.
REGISTRATION_CODE="081946"

# TEMPORARY. "1" lets someone choose their password on the register form
# instead of being emailed a one-time link, and makes the account usable at
# once. Anything else (including unset) keeps the link flow, which is the one
# to keep: a link proves the address exists before the account does, cannot be
# replayed, and leaves no password anywhere it could be read later.
#
# The registration code, the rate limits and the forced two-factor setup all
# still apply. See docs/operations/registration-code.md for how to remove it.
REGISTRATION_SET_PASSWORD_DIRECTLY=""

# ---------------------------------------------------------------------------
# Clinic domains (white label)
# ---------------------------------------------------------------------------
# Lets a platform admin give a clinic an address of its own
# (app.clinicname.nl) from /agency. Unset, the feature is off: the panel says
# so and the actions refuse, rather than half-attaching a domain nobody can
# verify. See docs/operations/clinic-domains.md.
#
# The token needs permission to edit this project's domains. VERCEL_TEAM_ID
# is only for a project owned by a team.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
