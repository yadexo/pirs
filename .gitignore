# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env — every env file is ignored by default. Only the two that hold no
# secrets are committed: the empty template and the throwaway local test config.
.env
.env*
!.env.example
!.env.test

# misc
.DS_Store

# keys and certificates
*.pem
*.key
*.p8
*.p12
*.pfx
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (local storage provider)
/public/uploads/*
!/public/uploads/.gitkeep

# testing
/coverage

# logs
*.log

# self-signed certificate for phone testing (scripts/https-proxy.mjs)
/.certs

# deployment
.vercel
